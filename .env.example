# Supabase → Project Settings → API / Database
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Project Settings → Database → Connection string → URI (Session pooler), with your DB password filled in
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
